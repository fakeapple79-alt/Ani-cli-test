# Placeholder only. Never put a real Telegram token in this file.
# Generate a new token with @BotFather after revoking the exposed token.
BOT_TOKEN=put_new_token_here

# Replace with the HTTPS domain generated by Railway.
PUBLIC_BASE_URL=https://your-service.up.railway.app

WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_a_long_random_secret

RESOLVER_TIMEOUT_SECONDS=50
MAX_CONCURRENT_RESOLVERS=2

# DesiDubAnime is the primary Hindi streaming catalog. Anime Sky and legacy sources are fallbacks.
HINDI_PROVIDER_ORDER=desidubanime,animesky,direct,tatakai,animeworld
DESIDUBANIME_BASE_URL=https://www.desidubanime.me
ANIMESKY_BASE_URL=https://animesky.top
HINDI_PROVIDER_TIMEOUT_SECONDS=12
# Set these only if you operate or trust a reachable deployment of the APIs.
TATAKAI_API_BASE_URL=
ANIMEWORLD_INDIA_API_BASE_URL=
